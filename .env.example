# Personal OS — every env var the build uses. Copy to .env.local for
# development, and push each one to Vercel (or your host) for production.
# See README.md for where each value comes from.

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM providers ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini

# ── Auth gate ────────────────────────────────────────────────────────
AUTH_SECRET=
DASHBOARD_PASSWORD=
API_SECRET=

# ── Telegram capture ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_ID=

# ── Calendar ─────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ICAL_URL=

# ── Finance Pulse ────────────────────────────────────────────────────
GOOGLE_SHEETS_FINANCE_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Cron ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ── App ──────────────────────────────────────────────────────────────
USER_TIMEZONE=UTC
USER_ID=me
